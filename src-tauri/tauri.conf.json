{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iconarium",
  "version": "0.1.0",
  "identifier": "com.echozed.iconarium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Iconarium",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: thumb: http://thumb.localhost svgfile: http://svgfile.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Eric Zimmerman",
    "copyright": "Copyright (c) 2026 Eric Zimmerman",
    "category": "Graphics",
    "shortDescription": "Search, preview, crop and copy SVGs from large libraries.",
    "longDescription": "Iconarium is a fast Windows browser for large SVG libraries. Search filenames and the text inside drawings, preview at any zoom, select a region, and copy or drag it straight into PowerPoint, Visio or draw.io as a vector.",
    "homepage": "https://github.com/echozulucode/iconarium",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/echozulucode/iconarium/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_ICONARIUM_UPDATER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
